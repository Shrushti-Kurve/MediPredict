# ====================================================================
# MediPredict Environment Configuration
# ====================================================================

# 1. Backend REST API URL (when backend is deployed)
# Leave empty to use local storage mock mode
VITE_API_BASE_URL=

# 2. Power BI Embedded Report URLs (Connected to your Database)
#
# How to get your Power BI Embed URL:
# 1. In Power BI Service (app.powerbi.com), open your report.
# 2. Go to: File -> Embed report -> "Publish to web (public)" OR "Website or portal"
# 3. Copy the URL and paste it below:

# Power BI Report for Doctor Dashboard (Clinical Outcomes & Disease Prevalence)
VITE_POWERBI_DOCTOR_URL=https://app.powerbi.com/view?r=your_doctor_report_embed_url_here

# Power BI Report for Hospital Staff Dashboard (Hospital Operations & Bed Occupancy)
VITE_POWERBI_HOSPITAL_URL=https://app.powerbi.com/view?r=your_hospital_staff_report_embed_url_here

# Power BI Report for Pharmacist Dashboard (Pharmacy Inventory & Supply Chain)
VITE_POWERBI_PHARMACY_URL=https://app.powerbi.com/view?r=your_pharmacy_report_embed_url_here
